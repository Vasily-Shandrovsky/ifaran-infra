[
  {
    "id": "infra-deploy",
    "execute-command": "/deploy/deploy-agent.sh",
    "command-working-directory": "/infra-repo",
    "trigger-rule": {
      "match": {
        "type": "payload-hmac-sha256",
        "secret": "__WEBHOOK_SECRET__",
        "parameter": {
          "source": "header",
          "name": "X-Hub-Signature-256"
        }
      }
    }
  }
]
